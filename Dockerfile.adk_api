FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY adk_server.py .
COPY agents/ ./agents/

ENV PORT=8003

# Run the ADK API server (headless, no web UI)
CMD uvicorn adk_server:app --host 0.0.0.0 --port ${PORT} --reload
